{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Hangfire": "Information",
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/chefnear-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=ChefNearDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "Key": "uhV1e7qNihSQy6dXDAUvawyBznO1uKv4fp2YYZQ3KSE",
    "Issuer": "ChefNear",
    "Audience": "ChefNearAPI",
    "DurationInMinutes": 60,
    "RefreshTokenDurationInDays": 7
  },
  "EmailSettings": {
    "Email": "ztkarmabwmtr@gmail.com",
    "Password": "havggeqgeblyyxvx",
    "Host": "smtp.gmail.com",
    "Port": 587
  },

  "AppUrlSettings": {
    "FrontendBaseUrl": "http://localhost:4200",
    "ApiBaseUrl": "https://depth-gumball-identity.ngrok-free.dev",
    "ResetPasswordPath": "api/v1/auth/reset-password",
    "ConfirmEmailPath": "api/v1/auth/confirm-email"
  },
  "FrontendSettings": {
    "BaseUrl": "http://localhost:4200",
    "Routes": {
      "PaymentResultUrl": "payment-result"
    }
  },
  "AllowedHosts": "*"
}